include README.md LICENSE NOTICE THIRD_PARTY_NOTICES.md CONTRIBUTING.md CHANGELOG.md requirements-lock.txt
recursive-include docs *.md
recursive-include configs *.json
recursive-include benchmarks *.json
recursive-include licenses *.txt
recursive-include tools *.py
recursive-include tests *.py
prune artifacts
prune outputs
prune output
prune data
prune .local-data
global-exclude __pycache__ *.py[cod] *.npz *.bvh *.stl *.STL *.pt *.mp4 *.gif
include docs/assets/demo.json docs/assets/original_q1_demo.mp4 docs/assets/original_q1_demo.gif
