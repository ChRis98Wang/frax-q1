include README.md LICENSE NOTICE THIRD_PARTY_NOTICES.md CONTRIBUTING.md CHANGELOG.md requirements-lock.txt
recursive-include docs *.md
recursive-include configs *.json
recursive-include benchmarks *.json
recursive-include licenses *.txt
recursive-include tools *.py
recursive-include tests *.py
prune artifacts
prune outputs
prune output
prune data
prune .local-data*
global-exclude __pycache__ *.py[cod] *.npz *.bvh *.stl *.STL *.pt *.mp4 *.gif
include docs/assets/lafan_demo.json docs/assets/lafan_quality.json docs/assets/lafan_q1_dynamic.mp4 docs/assets/lafan_q1_dynamic.gif
